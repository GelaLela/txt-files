-- ============================================
-- PORTFOLIO MANAGEMENT DATABASE
-- PostgreSQL / Aiven
-- 13 TABLES
-- ============================================

-- 1. USERS
CREATE TABLE users (
    user_ID BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    Email VARCHAR(255) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    role VARCHAR(50) NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    account_status VARCHAR(30) DEFAULT 'active',
    email_verified BOOLEAN NOT NULL DEFAULT FALSE,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- 2. PROFILE
CREATE TABLE profile (
    profile_ID BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    user_ID BIGINT NOT NULL,
    Lastname VARCHAR(100) NOT NULL,
    Firstname VARCHAR(100) NOT NULL,
    Middlename VARCHAR(100),
    Bio TEXT,
    Avatar_url TEXT,
    location VARCHAR(255),

    CONSTRAINT fk_profile_user
        FOREIGN KEY (user_ID)
        REFERENCES users(user_ID)
        ON DELETE CASCADE
);

-- 3. PROJECTS
CREATE TABLE Projects (
    project_ID BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    profile_ID BIGINT NOT NULL,
    project_title VARCHAR(255) NOT NULL,
    description TEXT,
    featured_img TEXT,
    is_featured BOOLEAN NOT NULL DEFAULT FALSE,
    url_link TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_project_profile
        FOREIGN KEY (profile_ID)
        REFERENCES profile(profile_ID)
        ON DELETE CASCADE
);

-- 4. PROJECT MEDIA
CREATE TABLE project_media (
    project_media_ID BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    project_ID BIGINT NOT NULL,
    media_type VARCHAR(50) NOT NULL,
    media_url TEXT NOT NULL,
    display_order INTEGER DEFAULT 0,
    media_title VARCHAR(255),
    media_description TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_project_media_project
        FOREIGN KEY (project_ID)
        REFERENCES Projects(project_ID)
        ON DELETE CASCADE
);

-- 5. SKILLS
CREATE TABLE skills (
    skills_ID BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    profile_ID BIGINT NOT NULL,
    category VARCHAR(100) NOT NULL,
    skill_name VARCHAR(100) NOT NULL,
    skill_description TEXT,
    proficiency_level VARCHAR(50),
    years_experience INTEGER DEFAULT 0,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_skills_profile
        FOREIGN KEY (profile_ID)
        REFERENCES profile(profile_ID)
        ON DELETE CASCADE,

    CONSTRAINT chk_skills_years
        CHECK (years_experience >= 0)
);

-- 6. SKILL PROFILE
CREATE TABLE skill_profile (
    skill_profile_ID BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    profile_ID BIGINT NOT NULL,
    skills_ID BIGINT NOT NULL,
    proficiency_level VARCHAR(50),
    years_experience INTEGER DEFAULT 0,
    is_primary BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_skill_profile_profile
        FOREIGN KEY (profile_ID)
        REFERENCES profile(profile_ID)
        ON DELETE CASCADE,

    CONSTRAINT fk_skill_profile_skill
        FOREIGN KEY (skills_ID)
        REFERENCES skills(skills_ID)
        ON DELETE CASCADE,

    CONSTRAINT uq_skill_profile
        UNIQUE (profile_ID, skills_ID),

    CONSTRAINT chk_skill_profile_years
        CHECK (years_experience >= 0)
);

-- 7. EDUCATION
CREATE TABLE education (
    education_ID BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    profile_ID BIGINT NOT NULL,
    school_name VARCHAR(255) NOT NULL,
    degree VARCHAR(255),
    field_of_study VARCHAR(255),
    start_date DATE,
    end_date DATE,
    description TEXT,

    CONSTRAINT fk_education_profile
        FOREIGN KEY (profile_ID)
        REFERENCES profile(profile_ID)
        ON DELETE CASCADE
);

-- 8. WORK EXPERIENCE
CREATE TABLE work_experience (
    experience_ID BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    profile_ID BIGINT NOT NULL,
    company_name VARCHAR(255) NOT NULL,
    job_title VARCHAR(255) NOT NULL,
    employment_type VARCHAR(100),
    start_date DATE,
    end_date DATE,
    description TEXT,

    CONSTRAINT fk_experience_profile
        FOREIGN KEY (profile_ID)
        REFERENCES profile(profile_ID)
        ON DELETE CASCADE
);

-- 9. CERTIFICATIONS
CREATE TABLE certifications (
    certification_ID BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    profile_ID BIGINT NOT NULL,
    certification_name VARCHAR(255) NOT NULL,
    issuing_organization VARCHAR(255),
    issue_date DATE,
    expiration_date DATE,
    credential_ID VARCHAR(255),
    credential_url TEXT,

    CONSTRAINT fk_certification_profile
        FOREIGN KEY (profile_ID)
        REFERENCES profile(profile_ID)
        ON DELETE CASCADE
);

-- 10. PROJECT SKILLS
CREATE TABLE project_skills (
    project_skill_ID BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    project_ID BIGINT NOT NULL,
    skills_ID BIGINT NOT NULL,
    usage_description TEXT,
    proficiency_level VARCHAR(50),
    is_primary BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_project_skills_project
        FOREIGN KEY (project_ID)
        REFERENCES Projects(project_ID)
        ON DELETE CASCADE,

    CONSTRAINT fk_project_skills_skill
        FOREIGN KEY (skills_ID)
        REFERENCES skills(skills_ID)
        ON DELETE CASCADE,

    CONSTRAINT uq_project_skill
        UNIQUE (project_ID, skills_ID)
);

-- 11. SOCIAL LINKS
CREATE TABLE social_links (
    social_link_ID BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    profile_ID BIGINT NOT NULL,
    platform VARCHAR(100) NOT NULL,
    username VARCHAR(255),
    url TEXT NOT NULL,
    display_order INTEGER DEFAULT 0,
    is_visible BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_social_profile
        FOREIGN KEY (profile_ID)
        REFERENCES profile(profile_ID)
        ON DELETE CASCADE
);

-- 12. MESSAGES
CREATE TABLE messages (
    message_ID BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    profile_ID BIGINT NOT NULL,
    sender_name VARCHAR(255) NOT NULL,
    sender_email VARCHAR(255) NOT NULL,
    subject VARCHAR(255),
    message TEXT NOT NULL,
    is_read BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_message_profile
        FOREIGN KEY (profile_ID)
        REFERENCES profile(profile_ID)
        ON DELETE CASCADE
);

-- 13. ANALYTICS
CREATE TABLE analytics (
    analytics_ID BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    profile_ID BIGINT NOT NULL,
    project_ID BIGINT,
    view_count INTEGER NOT NULL DEFAULT 1,
    visited_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    event_type VARCHAR(50) NOT NULL,
    analytics_source VARCHAR(100),
    visitor_ip INET,

    CONSTRAINT fk_analytics_profile
        FOREIGN KEY (profile_ID)
        REFERENCES profile(profile_ID)
        ON DELETE CASCADE,

    CONSTRAINT fk_analytics_project
        FOREIGN KEY (project_ID)
        REFERENCES Projects(project_ID)
        ON DELETE SET NULL,

    CONSTRAINT chk_view_count
        CHECK (view_count >= 0)
);


-- ============================================
-- INDEXES
-- ============================================

CREATE INDEX idx_profile_user
    ON profile(user_ID);

CREATE INDEX idx_projects_profile
    ON Projects(profile_ID);

CREATE INDEX idx_project_media_project
    ON project_media(project_ID);

CREATE INDEX idx_skills_profile
    ON skills(profile_ID);

CREATE INDEX idx_skill_profile_profile
    ON skill_profile(profile_ID);

CREATE INDEX idx_skill_profile_skill
    ON skill_profile(skills_ID);

CREATE INDEX idx_education_profile
    ON education(profile_ID);

CREATE INDEX idx_experience_profile
    ON work_experience(profile_ID);

CREATE INDEX idx_certifications_profile
    ON certifications(profile_ID);

CREATE INDEX idx_project_skills_project
    ON project_skills(project_ID);

CREATE INDEX idx_project_skills_skill
    ON project_skills(skills_ID);

CREATE INDEX idx_social_links_profile
    ON social_links(profile_ID);

CREATE INDEX idx_messages_profile
    ON messages(profile_ID);

CREATE INDEX idx_analytics_profile
    ON analytics(profile_ID);

CREATE INDEX idx_analytics_project
    ON analytics(project_ID);

CREATE INDEX idx_analytics_visited
    ON analytics(visited_at);

CREATE INDEX idx_analytics_profile_visited
    ON analytics(profile_ID, visited_at);

CREATE INDEX idx_analytics_project_visited
    ON analytics(project_ID, visited_at);
